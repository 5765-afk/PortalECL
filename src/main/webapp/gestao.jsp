<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*" %><% if(session.getAttribute("idUtilizador")==null){response.sendRedirect("login.jsp");return;} List<Map<String,Object>> avarias=(List<Map<String,Object>>)request.getAttribute("avarias"); %><!DOCTYPE html><html lang="pt"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Gestão de pedidos | PortalECL</title><link rel="stylesheet" href="css/estilo.css"></head><body><header class="topo"><a class="marca" href="index.jsp"><span class="marca-simbolo">E</span><span>Portal<strong>ECL</strong><small>Área de gestão</small></span></a><nav><a href="index.jsp">Ver portal</a><a class="nav-destaque" href="logout">Terminar sessão</a></nav></header><main class="pagina-gestao"><div class="gestao-cabecalho"><div><span class="etiqueta">PAINEL DE CONTROLO</span><h1>Pedidos de assistência</h1><p>Bem-vindo/a, <strong><%=session.getAttribute("nomeUtilizador")%></strong>. Consulta e atualiza o estado dos pedidos.</p></div><span class="contador"><%=avarias==null?0:avarias.size()%> pedidos</span></div><% if("1".equals(request.getParameter("atualizado"))){ %><div class="alerta sucesso">Estado atualizado com sucesso.</div><% } %><div class="tabela-wrap"><table><thead><tr><th>Pedido</th><th>Local</th><th>Descrição</th><th>Estado</th><th>Atualizar</th></tr></thead><tbody><% if(avarias!=null&&!avarias.isEmpty()){for(Map<String,Object>a:avarias){ %><tr><td><strong><%=a.get("nome")%></strong><small><%=a.get("data")%></small></td><td><%=a.get("sala")%><small><%=a.get("equipamento")==null?"":a.get("equipamento")%></small></td><td class="descricao-celula"><%=a.get("descricao")%></td><td><span class="estado"><%=a.get("estado")%></span></td><td><form class="form-estado" action="gestao" method="post"><input type="hidden" name="id" value="<%=a.get("id")%>"><select name="estado" aria-label="Novo estado"><option <%= "Por analisar".equals(a.get("estado"))?"selected":"" %>>Por analisar</option><option <%= "Em intervenção".equals(a.get("estado"))?"selected":"" %>>Em intervenção</option><option <%= "A aguardar".equals(a.get("estado"))?"selected":"" %>>A aguardar</option><option <%= "Resolvido".equals(a.get("estado"))?"selected":"" %>>Resolvido</option></select><button type="submit" class="botao pequeno">Guardar</button></form></td></tr><% }}else{ %><tr><td colspan="5" class="sem-registos">Ainda não existem pedidos registados.</td></tr><% } %></tbody></table></div></main><footer><div><strong>PortalECL</strong><span>Projeto académico demonstrativo.</span></div></footer></body></html>
