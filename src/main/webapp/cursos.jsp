<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.List" %><%@ page import="pt.ecl.model.Curso" %><!DOCTYPE html><html lang="pt"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Oferta formativa | PortalECL</title><link rel="stylesheet" href="css/estilo.css"></head><body><header class="topo"><a class="marca" href="index.jsp"><span class="marca-simbolo">E</span><span>Portal<strong>ECL</strong><small>Escola de Comércio de Lisboa</small></span></a><nav><a href="index.jsp">Início</a><a class="ativo" href="cursos">Cursos</a><a href="pre-inscricao.jsp">Pré-inscrição</a><a href="reportar-avaria.jsp">Assistência</a></nav></header><main class="pagina-form"><div class="form-intro"><span class="etiqueta">APRENDE E CONSTRÓI O TEU FUTURO</span><h1>Oferta formativa</h1><p>Explora os cursos disponíveis e encontra o percurso que combina com os teus objetivos.</p></div><div class="lista-cursos"><% List<Curso> cursos=(List<Curso>)request.getAttribute("cursos"); if(cursos!=null&&!cursos.isEmpty()){for(Curso curso:cursos){ %><article class="curso"><span class="etiqueta"><%=curso.getModalidade()%></span><h3><%=curso.getNome()%></h3><p><strong>Nível:</strong> <%=curso.getNivel()%></p><p><strong>Duração:</strong> <%=curso.getDuracao()%></p><p><%=curso.getDescricao()%></p><% if(curso.getPerfilSaida()!=null&&!curso.getPerfilSaida().isBlank()){ %><p><strong>Perfil de saída:</strong> <%=curso.getPerfilSaida()%></p><% } %><a class="texto-link" href="pre-inscricao.jsp">Tenho interesse <span>→</span></a></article><% }}else{ %><div class="alerta">De momento, não existem cursos disponíveis. Tenta novamente mais tarde.</div><% } %></div></main><footer><div><strong>PortalECL</strong><span>Projeto académico demonstrativo.</span></div></footer></body></html>
